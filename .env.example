# Copiá este archivo como .env y ajustá los valores según tu entorno
# cp .env.example .env

# Cuando el servidor corre fuera de Docker (desarrollo local):
DB_HOST=localhost
DB_PORT=5435

# Cuando el servidor corre dentro de Docker (docker-compose):
# DB_HOST=db
# DB_PORT=5432

# Clave secreta para firmar los tokens JWT del panel admin
# Cambiá esto por una cadena aleatoria larga antes de poner en producción
JWT_SECRET=cambia-esto-en-produccion
